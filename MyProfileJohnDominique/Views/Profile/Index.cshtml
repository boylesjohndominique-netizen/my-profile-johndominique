@model StudentMVC.Models.Profile

@{
    ViewData["Title"] = "My Personal Profile";

    var courseList = new List<SelectListItem>
    {
        new SelectListItem { Text = "BS Information Technology", Value = "BS Information Technology" },
        new SelectListItem { Text = "BS Computer Science", Value = "BS Computer Science" },
        new SelectListItem { Text = "BS Information Systems", Value = "BS Information Systems" },
        new SelectListItem { Text = "BS Computer Engineering", Value = "BS Computer Engineering" }
    };
}

<section class="spidey-page" aria-labelledby="profile-title">
    <div class="bg-web" aria-hidden="true"></div>
    <div class="bg-halftone" aria-hidden="true"></div>
    <div class="bg-glow bg-glow-red" aria-hidden="true"></div>
    <div class="bg-glow bg-glow-blue" aria-hidden="true"></div>

    <nav class="spidey-nav" aria-label="Profile sections">
        <a href="#identity" class="nav-brand" aria-label="My Profile home">
            <i class="fa-solid fa-spider" aria-hidden="true"></i>
            <span>My Profile</span>
        </a>
        <a href="#identity" data-spy="identity">
            <i class="fa-solid fa-user-secret" aria-hidden="true"></i>
            <span>About</span>
        </a>
        <a href="#stats" data-spy="stats">
            <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
            <span>Stats</span>
        </a>
        <a href="#edit" data-spy="edit">
            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
            <span>Edit</span>
        </a>
    </nav>

    <div class="page-shell">
        <!-- ============ HERO / SECRET IDENTITY ============ -->
        <header id="identity" class="hero-panel panel rise-in">
            <div class="hero-web" aria-hidden="true"></div>
            <div class="comic-burst" aria-hidden="true"><span>THWIP!</span></div>

            <div class="swing-wrap" aria-hidden="true">
                <span class="swing-line"></span>
                <i class="fa-solid fa-spider"></i>
            </div>

            <div class="status-pill">
                <i class="fa-solid fa-bolt" aria-hidden="true"></i>
                Student Developer
            </div>

            <div class="avatar-wrap" aria-label="Profile initials">
                <div class="avatar-ring"><span>JD</span></div>
                <div class="spider-badge"><i class="fa-solid fa-spider" aria-hidden="true"></i></div>
            </div>

            <p class="eyebrow"><i class="fa-solid fa-user-secret" aria-hidden="true"></i> Secret Identity</p>
            <h1 id="profile-title">@Model.Name</h1>
            <p class="course-line">@Model.Course</p>
            <p class="motto-pill">
                <i class="fa-solid fa-quote-left" aria-hidden="true"></i>
                "@Model.Motto"
            </p>
            <a href="#edit" class="cta-button">
                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                Update My Profile
            </a>
        </header>

        <!-- ============ THWIP MARQUEE ============ -->
        <div class="marquee" aria-hidden="true">
            <div class="marquee-track">
                <div class="marquee-group">
                    <span>THWIP</span><i class="fa-solid fa-spider"></i>
                    <span>Student Developer</span><i class="fa-solid fa-bolt"></i>
                    <span>Code &amp; Create</span><i class="fa-solid fa-code"></i>
                    <span>Full-Stack in Training</span><i class="fa-solid fa-rocket"></i>
                    <span>With Great Code Comes Great Responsibility</span><i class="fa-solid fa-book-open"></i>
                </div>
                <div class="marquee-group" aria-hidden="true">
                    <span>THWIP</span><i class="fa-solid fa-spider"></i>
                    <span>Student Developer</span><i class="fa-solid fa-bolt"></i>
                    <span>Code &amp; Create</span><i class="fa-solid fa-code"></i>
                    <span>Full-Stack in Training</span><i class="fa-solid fa-rocket"></i>
                    <span>With Great Code Comes Great Responsibility</span><i class="fa-solid fa-book-open"></i>
                </div>
            </div>
        </div>

        <!-- ============ QUICK STATS ============ -->
        <section id="stats" class="stats-grid" aria-label="Quick profile information">
            <article class="stat-card panel rise-in delay-one">
                <div class="stat-icon icon-red"><i class="fa-solid fa-cake-candles" aria-hidden="true"></i></div>
                <p>Age</p>
                <strong>@Model.Age</strong>
                <span class="stat-swoosh" aria-hidden="true"></span>
            </article>

            <article class="stat-card panel rise-in delay-two">
                <div class="stat-icon icon-blue"><i class="fa-solid fa-gamepad" aria-hidden="true"></i></div>
                <p>Hobby</p>
                <strong>@Model.Hobby</strong>
                <span class="stat-swoosh" aria-hidden="true"></span>
            </article>

            <article class="stat-card panel rise-in delay-three">
                <div class="stat-icon icon-red"><i class="fa-solid fa-book-open" aria-hidden="true"></i></div>
                <p>Favorite Subject</p>
                <strong>@Model.FavoriteSubject</strong>
                <span class="stat-swoosh" aria-hidden="true"></span>
            </article>

            <article class="stat-card panel rise-in delay-four">
                <div class="stat-icon icon-blue"><i class="fa-solid fa-rocket" aria-hidden="true"></i></div>
                <p>Career Goal</p>
                <strong>@Model.CareerGoal</strong>
                <span class="stat-swoosh" aria-hidden="true"></span>
            </article>
        </section>

        <!-- ============ ABOUT + POWER REPORT ============ -->
        <section class="content-grid">
            <article class="identity-card panel rise-in delay-two">
                <div class="section-heading">
                    <p class="eyebrow"><i class="fa-solid fa-fingerprint" aria-hidden="true"></i> Secret Identity</p>
                    <h2>About Me</h2>
                </div>

                <dl class="detail-list">
                    <div>
                        <dt><i class="fa-solid fa-user" aria-hidden="true"></i> Name</dt>
                        <dd>@Model.Name</dd>
                    </div>
                    <div>
                        <dt><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i> Course</dt>
                        <dd>@Model.Course</dd>
                    </div>
                    <div>
                        <dt><i class="fa-solid fa-cake-candles" aria-hidden="true"></i> Age</dt>
                        <dd>@Model.Age</dd>
                    </div>
                    <div>
                        <dt><i class="fa-solid fa-gamepad" aria-hidden="true"></i> Hobby</dt>
                        <dd>@Model.Hobby</dd>
                    </div>
                    <div>
                        <dt><i class="fa-solid fa-book-open" aria-hidden="true"></i> Favorite Subject</dt>
                        <dd>@Model.FavoriteSubject</dd>
                    </div>
                    <div>
                        <dt><i class="fa-solid fa-rocket" aria-hidden="true"></i> Career Goal</dt>
                        <dd>@Model.CareerGoal</dd>
                    </div>
                    <div>
                        <dt><i class="fa-solid fa-envelope" aria-hidden="true"></i> Email</dt>
                        <dd>@Model.Email</dd>
                    </div>
                    <div>
                        <dt><i class="fa-solid fa-quote-left" aria-hidden="true"></i> Motto</dt>
                        <dd>@Model.Motto</dd>
                    </div>
                </dl>
            </article>

            <article class="power-card panel rise-in delay-three">
                <div class="section-heading">
                    <p class="eyebrow"><i class="fa-solid fa-bolt" aria-hidden="true"></i> Razor Report</p>
                    <h2>Super Powers</h2>
                </div>

                <p>
                    This profile is created solely to demonstrate Razor syntax in ASP.NET Core MVC.
                    Every value below is rendered dynamically with <code>@@Model.Property</code>,
                    letting C# code live right inside the HTML markup.
                </p>

                <div class="power-list" aria-label="Skill levels">
                    <div class="power-row">
                        <span><i class="fa-solid fa-code" aria-hidden="true"></i> C# Coding</span>
                        <b>96%</b>
                        <div class="power-bar"><span style="width: 96%"></span></div>
                    </div>
                    <div class="power-row">
                        <span><i class="fa-solid fa-spider" aria-hidden="true"></i> Web-Slinging</span>
                        <b>100%</b>
                        <div class="power-bar"><span style="width: 100%"></span></div>
                    </div>
                    <div class="power-row">
                        <span><i class="fa-solid fa-gamepad" aria-hidden="true"></i> Gaming Reflexes</span>
                        <b>88%</b>
                        <div class="power-bar"><span style="width: 88%"></span></div>
                    </div>
                    <div class="power-row">
                        <span><i class="fa-solid fa-rocket" aria-hidden="true"></i> Ambition</span>
                        <b>100%</b>
                        <div class="power-bar"><span style="width: 100%"></span></div>
                    </div>
                </div>

                <div class="code-chip-row" aria-label="Rendered Razor values">
                    <span>@Model.Name</span>
                    <span>@Model.Course</span>
                    <span>@Model.FavoriteSubject</span>
                </div>
            </article>
        </section>

        <!-- ============ EDIT PROFILE ============ -->
        <section id="edit" class="edit-card panel rise-in delay-four" aria-labelledby="edit-title">
            <div class="section-heading">
                <p class="eyebrow"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i> HTML Helpers</p>
                <h2 id="edit-title">Update My Profile</h2>
            </div>

            <form class="profile-form">
                <div class="form-grid">
                    <div class="field">
                        @Html.LabelFor(model => model.Name)
                        @Html.TextBoxFor(model => model.Name)
                    </div>

                    <div class="field">
                        @Html.LabelFor(model => model.Course)
                        @Html.DropDownListFor(model => model.Course, courseList)
                    </div>

                    <div class="field">
                        @Html.LabelFor(model => model.Age)
                        @Html.EditorFor(model => model.Age)
                    </div>

                    <div class="field">
                        @Html.LabelFor(model => model.Hobby)
                        @Html.TextBoxFor(model => model.Hobby)
                    </div>

                    <div class="field">
                        @Html.LabelFor(model => model.FavoriteSubject)
                        @Html.TextBoxFor(model => model.FavoriteSubject)
                    </div>

                    <div class="field">
                        @Html.LabelFor(model => model.CareerGoal)
                        @Html.TextBoxFor(model => model.CareerGoal)
                    </div>

                    <div class="field">
                        @Html.LabelFor(model => model.Email)
                        <input id="Email" name="Email" type="email" value="@Model.Email" />
                    </div>

                    <div class="field field-wide">
                        @Html.LabelFor(model => model.Motto)
                        @Html.TextAreaFor(model => model.Motto)
                    </div>
                </div>

                <button type="submit" class="save-button">
                    <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                    Save Profile
                </button>
            </form>
        </section>

        <footer class="profile-footer">
            <i class="fa-solid fa-spider" aria-hidden="true"></i>
            <p>Created by John Dominique G. Boyles</p>
            <strong>C# Activity Project</strong>
        </footer>
    </div>
</section>
